# Next.js server-side database access
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/upsale?retryWrites=true&w=majority

# Application signing and encryption (use separate long random values in production)
JWT_SECRET=change-me-to-a-long-random-value
PLATFORM_SECRETS_KEY=change-me-to-another-long-random-value
AUTH_SECRET=change-me-to-another-long-random-value

# Protected connection to the Nest email service
BACKEND_INTERNAL_URL=http://localhost:4000
INTERNAL_API_SECRET=use-the-same-long-random-value-as-backend

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_VIDEO_URL=https://res.cloudinary.com/your-cloud/video/upload/upsale/demo/product-demo.mp4
