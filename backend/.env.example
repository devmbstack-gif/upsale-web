FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_SECRET=change-me-in-production

# Email delivery (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=google-app-password
SMTP_FROM=UPSale <sender@example.com>

# Must match frontend INTERNAL_API_SECRET
INTERNAL_API_SECRET=use-a-long-random-value

# Stripe billing (server-side only)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Meta WhatsApp Cloud API (server-side only)
