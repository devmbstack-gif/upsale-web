# Testing only. Change to true before production.
WHATSAPP_NUMBER_VERIFICATION_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
WHATSAPP_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-secret
